<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eShop</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="d-flex flex-column min-vh-100">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark eshop-navbar">
            <div class="container">
                <a class="navbar-brand" href="/">eShop</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" href="/Catalog/Default.aspx">Catalog</a></li>
                    </ul>
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                        <li class="nav-item me-3"><a class="nav-link" href="/Cart/ShoppingCart.aspx" aria-label="Shopping cart">Cart</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><span class="nav-link">Welcome, @User.Identity.Name</span></li>
                            <li class="nav-item"><a class="nav-link" href="/Checkout/OrderHistory.aspx">My Orders</a></li>
                            <li class="nav-item"><form method="post" action="/Account/Logout"><button class="btn nav-link">Sign Out</button></form></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="/Account/Login.aspx">Sign In</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Account/Register.aspx">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <main class="container my-4 flex-grow-1">
            @RenderBody()
        </main>

        <footer class="footer bg-dark text-white py-3 mt-auto">
            <div class="container text-center"><small>eShop</small></div>
        </footer>
    </div>

    <script src="~/Scripts/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>