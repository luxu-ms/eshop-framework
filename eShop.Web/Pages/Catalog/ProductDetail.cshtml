@page "/Catalog/ProductDetail.aspx"
@model eShop.Web.Pages.Catalog.ProductDetailModel
@{ ViewData["Title"] = "Product Detail"; }
@if (Model.Item == null)
{
    <div class="alert alert-warning">Product not found. <a href="/Catalog/Default.aspx">Back to Catalog</a></div>
}
else
{
    <nav class="mb-3"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Catalog/Default.aspx">Catalog</a></li><li class="breadcrumb-item active">@Model.Item.Name</li></ol></nav>
    <div class="row g-5"><div class="col-md-5 text-center"><img src="@(Model.Item.PictureUri ?? "/Content/placeholder.png")" class="img-fluid rounded shadow product-detail-img" alt="@Model.Item.Name" /></div>
    <div class="col-md-7"><h2 class="fw-bold">@Model.Item.Name</h2><p><span class="badge bg-secondary">@Model.Item.CatalogBrand.Brand</span> <span class="badge bg-info text-dark">@Model.Item.CatalogType.Type</span></p>
    <h3 class="text-success my-3">$@Model.Item.Price.ToString("0.00")</h3><p class="lead">@Model.Item.Description</p><span class="badge @(Model.Item.AvailableStock > 0 ? "bg-success" : "bg-danger")">@(Model.Item.AvailableStock > 0 ? $"In Stock ({Model.Item.AvailableStock} available)" : "Out of Stock")</span>
    <form method="post" class="d-flex align-items-center gap-3 mt-4"><input type="hidden" name="id" value="@Model.Item.Id" /><input class="form-control" style="max-width:100px" type="number" name="quantity" value="1" min="1" max="99" /><button class="btn btn-primary btn-lg">Add to Cart</button></form>
    @if (Model.Added) { <div class="alert alert-success mt-3">Item added to your cart. <a href="/Cart/ShoppingCart.aspx">View Cart</a></div> }
    </div></div>
}