@page "/Catalog/Default.aspx"
@model eShop.Web.Pages.Catalog.CatalogModel
@{
    ViewData["Title"] = "Catalog";
}
<h1 class="display-6 fw-bold mb-4">Catalog</h1>
<form method="get" class="row g-3 mb-4">
    <div class="col-md-3"><label class="form-label fw-semibold">Brand</label><select name="brand" class="form-select" asp-items="Model.BrandOptions" onchange="this.form.submit()"></select></div>
    <div class="col-md-3"><label class="form-label fw-semibold">Type</label><select name="type" class="form-select" asp-items="Model.TypeOptions" onchange="this.form.submit()"></select></div>
    <div class="col-md-4"><label class="form-label fw-semibold">Search</label><div class="input-group"><input name="q" value="@Model.Search" class="form-control" placeholder="Search products..." /><button class="btn btn-outline-secondary">Search</button></div></div>
</form>
@if (Model.Items.Count == 0)
{
    <div class="text-center py-5"><p class="text-muted fs-5">No products found matching your criteria.</p><a href="/Catalog/Default.aspx" class="btn btn-outline-primary">Clear Filters</a></div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var item in Model.Items)
    {
        <div class="col"><div class="card h-100 shadow-sm product-card">
            <a href="/Catalog/ProductDetail.aspx?id=@item.Id"><img src="@(item.PictureUri ?? "/Content/placeholder.png")" class="card-img-top product-img" alt="@item.Name" /></a>
            <div class="card-body d-flex flex-column"><h6 class="card-title">@item.Name</h6><p class="card-text text-muted small flex-grow-1">@item.CatalogBrand.Brand - @item.CatalogType.Type</p>
                <div class="d-flex justify-content-between align-items-center mt-2"><span class="fs-5 fw-bold text-success">$@item.Price.ToString("0.00")</span>
                    <form method="post" asp-page-handler="Add"><input type="hidden" name="itemId" value="@item.Id" /><button class="btn btn-primary btn-sm">Add to Cart</button></form>
                </div>
            </div>
        </div></div>
    }
    </div>
}
@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-center mt-4"><ul class="pagination">
        <li class="page-item @(Model.PageIndex == 0 ? "disabled" : "")"><a class="page-link" href="@Model.PageUrl(Model.PageIndex - 1)">Previous</a></li>
        <li class="page-item disabled"><span class="page-link">Page @(Model.PageIndex + 1) of @Model.TotalPages</span></li>
        <li class="page-item @(Model.PageIndex + 1 >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Model.PageUrl(Model.PageIndex + 1)">Next</a></li>
    </ul></nav>
}