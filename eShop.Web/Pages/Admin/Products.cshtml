@page "/Admin/Products.aspx"
@model eShop.Web.Pages.Admin.ProductsModel
@{ ViewData["Title"]="Products"; }
<h1>Products</h1>@if(!string.IsNullOrEmpty(Model.Message)){<div class="alert alert-success">@Model.Message</div>}
<div class="card mb-4"><div class="card-body"><h4>@(Model.Id==0?"Add Product":"Edit Product")</h4><form method="post" asp-page-handler="Save"><input type="hidden" asp-for="Id" /><div class="row g-2"><div class="col-md-4"><input asp-for="Name" class="form-control" placeholder="Name" /></div><div class="col-md-2"><input asp-for="Price" class="form-control" placeholder="Price" /></div><div class="col-md-2"><input asp-for="Stock" class="form-control" placeholder="Stock" /></div><div class="col-md-2"><select asp-for="BrandId" asp-items="Model.Brands" class="form-select"></select></div><div class="col-md-2"><select asp-for="TypeId" asp-items="Model.Types" class="form-select"></select></div><div class="col-12"><textarea asp-for="Description" class="form-control" placeholder="Description"></textarea></div></div><button class="btn btn-primary mt-2">Save</button></form></div></div>
<table class="table"><thead><tr><th>Name</th><th>Price</th><th>Stock</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.Name</td><td>$@item.Price.ToString("0.00")</td><td>@item.AvailableStock</td><td class="text-end"><a href="?id=@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a> <form method="post" asp-page-handler="Delete" class="d-inline"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table>