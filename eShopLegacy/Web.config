<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <!-- Register the configBuilders section to enable Azure Key Vault Configuration Builders -->
    <section name="configBuilders" type="System.Configuration.ConfigurationBuildersSection, System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" restartOnExternalChanges="false" requirePermission="false" />
  </configSections>

  <!--
    Azure Key Vault Configuration Builders
    =======================================
    Secrets are loaded from Azure Key Vault at runtime using DefaultAzureCredential
    (Managed Identity in Azure, developer credentials locally via Azure CLI / Visual Studio).

    Required Key Vault secrets (KV secret name → config key):
      connectionStrings section:
        eShopContext        → connectionStrings["eShopContext"]
        RedisConnection     → connectionStrings["RedisConnection"]
      appSettings section:
        AzureBlobStorageEndpoint → appSettings["AzureBlobStorageEndpoint"]
        CdnBaseUrl               → appSettings["CdnBaseUrl"]
        ida--ClientId            → appSettings["ida:ClientId"]   (colon becomes double-dash in KV)
        ida--TenantId            → appSettings["ida:TenantId"]   (colon becomes double-dash in KV)

    Set the KEYVAULT_NAME environment variable (or Azure App Service Application Setting)
    to the name of your Azure Key Vault (e.g. "my-eshop-keyvault").
  -->
  <configBuilders>
    <builders>
      <add name="AzureKeyVault"
           vaultName="${KEYVAULT_NAME}"
           type="Microsoft.Configuration.ConfigurationBuilders.AzureKeyVaultConfigBuilder, Microsoft.Configuration.ConfigurationBuilders.Azure, Version=3.0.0.0, Culture=neutral"
           mode="Greedy"
           optional="true" />
    </builders>
  </configBuilders>

  <!-- Connection strings are resolved at runtime from Azure Key Vault.
       Placeholder values below are overridden by the AzureKeyVault configBuilder.
       Store the actual values as secrets in Key Vault using the same names:
         Secret "eShopContext"   → full SQL connection string
         Secret "RedisConnection" → full Redis connection string -->
  <connectionStrings configBuilders="AzureKeyVault">
    <add name="eShopContext"
         connectionString="placeholder-overridden-by-key-vault"
         providerName="Microsoft.Data.SqlClient" />
    <add name="RedisConnection"
         connectionString="placeholder-overridden-by-key-vault" />
  </connectionStrings>

  <appSettings configBuilders="AzureKeyVault">
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="false" />
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <add key="CatalogItemsPerPage" value="10" />
    <!-- Name of the Azure Key Vault instance (non-sensitive). Used by the AzureKeyVault configBuilder above.
         Override via the KEYVAULT_NAME environment variable or Azure App Service Application Settings. -->
    <add key="KEYVAULT_NAME" value="your-keyvault-name" />
    <!-- Sensitive values below are placeholders. The AzureKeyVault configBuilder will override them
         at runtime with values from Azure Key Vault. Store the actual values as Key Vault secrets:
           Secret "AzureBlobStorageEndpoint" → https://<storage-account>.blob.core.windows.net
           Secret "CdnBaseUrl"               → https://<cdn-endpoint>.azureedge.net
           Secret "ida--ClientId"            → your Azure AD application (client) ID
           Secret "ida--TenantId"            → your Azure AD tenant ID
    -->
    <add key="AzureBlobStorageEndpoint" value="placeholder-overridden-by-key-vault" />
    <add key="CdnBaseUrl" value="placeholder-overridden-by-key-vault" />
    <!-- Microsoft Entra ID (Azure AD) settings -->
    <add key="ida:ClientId" value="placeholder-overridden-by-key-vault" />
    <add key="ida:AADInstance" value="https://login.microsoftonline.com/{0}" />
    <add key="ida:Domain" value="yourdomain.onmicrosoft.com" />
    <add key="ida:TenantId" value="placeholder-overridden-by-key-vault" />
    <add key="ida:PostLogoutRedirectUri" value="https://localhost:44300/" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- Authentication is handled by OWIN OpenIdConnect middleware (Microsoft Entra ID) -->
    <authentication mode="None" />
    <authorization>
      <allow users="*" />
    </authorization>
    <!-- Session state backed by Azure Cache for Redis for distributed, scale-out support.
         The connectionString attribute references the "RedisConnection" named connection string,
         whose value is securely loaded at runtime from Azure Key Vault via configBuilders.
         The Microsoft.Web.RedisSessionStateProvider serializes session data automatically;
         Session['AnonymousBuyerId'] (string) is natively compatible. -->
    <sessionState mode="Custom" customProvider="RedisSessionStateStore" timeout="60">
      <providers>
        <add name="RedisSessionStateStore"
             type="Microsoft.Web.Redis.RedisSessionStateProvider"
             connectionString="RedisConnection"
             throwOnError="true"
             retryTimeoutInMilliseconds="5000"
             databaseId="0"
             applicationName="eShopLegacy" />
      </providers>
    </sessionState>
    <customErrors mode="Off" />
    <pages controlRenderingCompatibilityVersion="4.0">
      <controls />
    </pages>
  </system.web>

  <system.webServer>
    <!-- Microsoft.AspNet.SessionState.SessionStateModule provides async session support
         required by Microsoft.Web.RedisSessionStateProvider 5.x. -->
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="Session" />
      <add name="Session"
           type="Microsoft.AspNet.SessionState.SessionStateModuleAsync, Microsoft.AspNet.SessionState.SessionStateModule, Version=2.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
           preCondition="integratedMode,managedHandler" />
    </modules>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>

  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="Microsoft.Data.SqlClient" type="System.Data.Entity.SqlServer.MicrosoftSqlProviderServices, Microsoft.EntityFramework.SqlServer" />
    </providers>
  </entityFramework>

  <system.data>
    <DbProviderFactories>
      <add name="SqlClient Data Provider"
           invariant="Microsoft.Data.SqlClient"
           description=".NET Framework Data Provider for SqlServer"
           type="Microsoft.Data.SqlClient.SqlClientFactory, Microsoft.Data.SqlClient" />
    </DbProviderFactories>
  </system.data>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="EntityFramework" publicKeyToken="b77a5c561934e089" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.2.0" newVersion="4.2.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin.Security" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.2.0" newVersion="4.2.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin.Security.Cookies" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.2.0" newVersion="4.2.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.IdentityModel.Tokens" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-7.7.1.0" newVersion="7.7.1.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.IdentityModel.Protocols" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-7.7.1.0" newVersion="7.7.1.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.IdentityModel.Protocols.OpenIdConnect" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-7.7.1.0" newVersion="7.7.1.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.IdentityModel.Tokens.Jwt" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-7.7.1.0" newVersion="7.7.1.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.IdentityModel.Logging" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-7.7.1.0" newVersion="7.7.1.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.IdentityModel.JsonWebTokens" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-7.7.1.0" newVersion="7.7.1.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
