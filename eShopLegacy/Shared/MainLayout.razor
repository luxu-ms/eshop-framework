@inherits LayoutComponentBase

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                <a class="navbar-brand" href="/">eShop Legacy</a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mr-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/catalog">Catalog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/cart">Cart</a>
                        </li>
                    </ul>
                    <AuthorizeView>
                        <Authorized>
                            <span class="navbar-text text-white mr-3">Hello, @context.User.Identity.Name!</span>
                            <a class="btn btn-outline-light btn-sm" href="/Account/Logout">Logout</a>
                        </Authorized>
                        <NotAuthorized>
                            <a class="btn btn-outline-light btn-sm mr-2" href="/Account/Login">Login</a>
                            <a class="btn btn-primary btn-sm" href="/Account/Register">Register</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </nav>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-12">
            <main class="py-4">
                @Body
            </main>
        </div>
    </div>
</div>
