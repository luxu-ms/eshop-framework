@page "/catalog/{Id:int}"
@inject CatalogService CatalogService
@inject BasketService BasketService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>@(product?.Name ?? "Product") - eShopLegacy</PageTitle>

@if (notFound)
{
    <div class="alert alert-warning">
        Product not found. <a href="/catalog">Back to Catalog</a>
    </div>
}
else if (product == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/catalog">Catalog</a></li>
            <li class="breadcrumb-item active">@product.Name</li>
        </ol>
    </nav>

    <div class="row g-5">
        <!-- Image -->
        <div class="col-md-5 text-center">
            <img src="@product.PictureUri"
                 class="img-fluid rounded shadow product-detail-img"
                 alt="@product.Name"
                 onerror="this.onerror=null;this.src='/Content/placeholder.png';" />
        </div>

        <!-- Details -->
        <div class="col-md-7">
            <h2 class="fw-bold">@product.Name</h2>
            <p class="text-muted mb-1">
                <span class="badge bg-secondary me-1">@product.CatalogBrand?.Brand</span>
                <span class="badge bg-info text-dark">@product.CatalogType?.Type</span>
            </p>
            <h3 class="text-success my-3">$@product.Price.ToString("0.00")</h3>
            <p class="lead">@product.Description</p>

            <div class="mb-3">
                @if (product.AvailableStock > 0)
                {
                    <span class="badge bg-success">In Stock (@product.AvailableStock available)</span>
                }
                else
                {
                    <span class="badge bg-danger">Out of Stock</span>
                }
            </div>

            <div class="d-flex align-items-center gap-3 mt-4">
                <div class="input-group" style="max-width:130px">
                    <span class="input-group-text">Qty</span>
                    <input type="number" class="form-control text-center" @bind="quantity" min="1" max="99" />
                </div>
                <button class="btn btn-primary btn-lg"
                        @onclick="AddToCartAsync"
                        disabled="@(product.AvailableStock <= 0)">
                    Add to Cart
                </button>
            </div>

            @if (addedToCart)
            {
                <div class="alert alert-success mt-3">
                    Item added to your cart. <a href="/basket">View Cart</a>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private CatalogItem? product;
    private bool notFound;
    private bool addedToCart;
    private int quantity = 1;

    protected override async Task OnInitializedAsync()
    {
        product = await CatalogService.GetCatalogItemAsync(Id);
        notFound = product == null;
    }

    private async Task AddToCartAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!(user.Identity?.IsAuthenticated ?? false))
        {
            Nav.NavigateTo($"/account/login?returnUrl=/catalog/{Id}");
            return;
        }

        var userId = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null && product != null)
        {
            await BasketService.AddItemToBasketAsync(userId, product.Id, product.Price, quantity);
            addedToCart = true;
        }
    }
}
