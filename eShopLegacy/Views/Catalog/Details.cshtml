@model eShopLegacy.Models.CatalogItem
@{
    ViewBag.Title = Model.Name;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Catalog")">Catalog</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-4 text-center">
        <img src="@Model.PictureUri" alt="@Model.Name" class="img-fluid rounded" style="max-height:350px;" onerror="this.onerror=null;this.src='/Content/placeholder.png';" />
    </div>
    <div class="col-md-8">
        <h2>@Model.Name</h2>
        <p class="text-muted mb-1"><strong>Brand:</strong> @(Model.CatalogBrand != null ? Model.CatalogBrand.Brand : "")</p>
        <p class="text-muted mb-2"><strong>Type:</strong> @(Model.CatalogType != null ? Model.CatalogType.Type : "")</p>
        <p><strong>Description:</strong> @Model.Description</p>
        <h4 class="text-primary my-3">$@Model.Price.ToString("0.00")</h4>
        @{
            string stockClass = Model.AvailableStock > 0 ? "badge bg-success" : "badge bg-danger";
            string stockText  = Model.AvailableStock > 0 ? $"In Stock ({Model.AvailableStock} available)" : "Out of Stock";
        }
        <span class="@stockClass mb-3 d-inline-block">@stockText</span>

        <form method="post" action="@Url.Action("AddToCart", "Catalog")" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="input-group" style="max-width:180px;">
                <label class="input-group-text" for="quantity">Qty</label>
                <input type="number" id="quantity" name="quantity" value="1" min="1" max="@Model.AvailableStock" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary mt-3" @(Model.AvailableStock == 0 ? "disabled" : "")>
                Add to Cart
            </button>
        </form>
    </div>
</div>
