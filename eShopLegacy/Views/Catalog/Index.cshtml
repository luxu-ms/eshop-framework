@model eShopLegacy.Models.ViewModels.CatalogIndexViewModel
@{
    ViewBag.Title = "Catalog";
}

<h2 class="mb-4">Product Catalog</h2>

<form method="get" action="@Url.Action("Index", "Catalog")" class="row g-3 mb-4 align-items-end">
    <div class="col-md-4">
        <label class="form-label">Brand</label>
        <select name="brand" class="form-select">
            <option value="0" @(Model.SelectedBrandId == null || Model.SelectedBrandId == 0 ? "selected" : "")>All Brands</option>
            @foreach (var b in Model.Brands)
            {
                <option value="@b.Id" @(Model.SelectedBrandId == b.Id ? "selected" : "")>@b.Brand</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Type</label>
        <select name="type" class="form-select">
            <option value="0" @(Model.SelectedTypeId == null || Model.SelectedTypeId == 0 ? "selected" : "")>All Types</option>
            @foreach (var t in Model.Types)
            {
                <option value="@t.Id" @(Model.SelectedTypeId == t.Id ? "selected" : "")>@t.Type</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Search</label>
        <input type="text" name="q" value="@Model.SearchText" class="form-control" placeholder="Search products..." />
    </div>
    <div class="col-md-1 d-flex gap-1">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
    @if (!string.IsNullOrEmpty(Model.SearchText) || Model.SelectedBrandId > 0 || Model.SelectedTypeId > 0)
    {
        <div class="col-12">
            <a href="@Url.Action("Index", "Catalog")" class="btn btn-outline-secondary btn-sm">Clear Filters</a>
        </div>
    }
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">No products found matching your criteria.</div>
}

@if (Model.Items.Count > 0)
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@item.PictureUri" class="card-img-top" alt="@item.Name" style="height:180px;object-fit:contain;padding:1rem;" onerror="this.onerror=null;this.src='/Content/placeholder.png';" />
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title">@item.Name</h6>
                        <p class="text-muted small mb-1">@(item.CatalogBrand != null ? item.CatalogBrand.Brand : "") &bull; @(item.CatalogType != null ? item.CatalogType.Type : "")</p>
                        <p class="fw-bold text-primary mt-auto mb-2">$@item.Price.ToString("0.00")</p>
                        <form method="post" action="@Url.Action("AddToCart", "Catalog")" class="d-grid">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Add to Cart</button>
                        </form>
                    </div>
                    <div class="card-footer">
                        <a href="@Url.Action("Details", "Catalog", new { id = item.Id })" class="btn btn-link btn-sm p-0">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", "Catalog", new { page = Model.CurrentPage - 1, brand = Model.SelectedBrandId, type = Model.SelectedTypeId, q = Model.SearchText })">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @(Model.CurrentPage + 1) of @Model.TotalPages</span>
            </li>
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", "Catalog", new { page = Model.CurrentPage + 1, brand = Model.SelectedBrandId, type = Model.SelectedTypeId, q = Model.SearchText })">Next</a>
            </li>
        </ul>
    </nav>
}
