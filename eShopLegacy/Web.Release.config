<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Web.Release.config — Production deployment transformations
    ==========================================================
    Connection strings and sensitive app settings are no longer managed here.
    All sensitive values (eShopContext, RedisConnection, AzureBlobStorageEndpoint,
    CdnBaseUrl, ida:ClientId, ida:TenantId) are securely loaded at runtime from
    Azure Key Vault via the AzureKeyVaultConfigBuilder configured in Web.config.

    Only set KEYVAULT_NAME (the name of your Azure Key Vault) as an Azure App Service
    Application Setting — the configuration builder will resolve all other secrets.
  -->
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="On" xdt:Transform="SetAttributes(mode)" />
  </system.web>
</configuration>
